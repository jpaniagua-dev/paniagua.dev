---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { brand, positioning } = content[lang];

// The promise is split so each word carries its own scroll timeline and the
// sentence assembles as the reader arrives at it. The string itself is
// untouched, so it still reads as one sentence to a screen reader.
const words = positioning.promise.split(' ');
---

{/* Opening scene. The text comes first in the DOM: on a phone the portrait
    used to fill the first screen, so a visitor had to scroll before learning
    what the site was about. On desktop the grid puts the photograph back on
    the left. */}
<section class="min-h-[100dvh] py-28 sm:py-32">
  <div class="mx-auto grid w-full max-w-[1600px] items-center gap-10 md:grid-cols-12 md:gap-16">
    <div
      class="flex flex-col justify-center px-5 sm:px-8 md:col-span-7 md:col-start-6 md:row-start-1"
    >
      <p class="field rise">{positioning.role}</p>

      <h1 class="display settle-type mt-6 text-[clamp(2.5rem,7.5vw,6.5rem)] text-ink">
        <span class="block">Paniagua</span>
        <span class="accent-type block">.dev</span>
      </h1>

      <p class="field rise rise-2 mt-6">
        {brand.legal} &nbsp;/&nbsp; {brand.place}
      </p>

      <div class="draw mt-8 h-[3px] w-full accent-bar"></div>

      <p
        class="dim-out mt-8 max-w-[24ch] text-[clamp(1.375rem,3.2vw,2.75rem)] leading-[1.2] text-dim"
      >
        {
          // The separating space sits outside the inline-block: inside one
          // it collapses, and the sentence renders as a single long word.
          words.map((word) => (
            <>
              <span class="word-in inline-block">{word}</span>{' '}
            </>
          ))
        }
      </p>
    </div>

    <div class="md:col-span-5 md:col-start-1 md:row-start-1">
      <div class="md:sticky md:top-24">
        {/* Graded so the clipped studio backdrop lands exactly on the page
            colour: the frame disappears and only the lit side of the face
            reads. Capped on small screens so it never dominates the fold. */}
        <Image
          src={portrait}
          alt={`Portrait de ${positioning.name}`}
          widths={[420, 640, 900]}
          sizes="(min-width: 768px) 42vw, 100vw"
          loading="lazy"
          decoding="async"
          class="parallax max-h-[58vh] w-full object-cover object-top md:max-h-none"
        />
      </div>
    </div>
  </div>
</section>
