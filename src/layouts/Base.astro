---
import '../styles/global.css';
import { LANGS, content, pathFor, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { meta, skipToContent, positioning } = content[lang];

const canonical = new URL(pathFor(lang), Astro.site).href;
const shareImage = new URL('/og-image.png', Astro.site).href;

// Both languages point at each other, plus an x-default so a search engine
// with no language signal has somewhere defined to land.
const alternates = LANGS.map((code) => ({
  code,
  href: new URL(pathFor(code), Astro.site).href,
}));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Paniagua.dev',
  description: meta.description,
  url: 'https://paniagua.dev',
  image: shareImage,
  email: 'contact@paniagua.dev',
  inLanguage: LANGS,
  founder: {
    '@type': 'Person',
    name: positioning.name,
    jobTitle: 'Front-End Engineer',
  },
  areaServed: { '@type': 'City', name: 'Geneva' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Geneva',
    addressRegion: 'GE',
    addressCountry: 'CH',
  },
  knowsAbout: [
    'Angular',
    'Web performance',
    'Web accessibility',
    'Front-end migration',
  ],
  sameAs: [
    'https://www.linkedin.com/in/juliopaniagua',
    'https://github.com/jpaniagua-dev',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* The page's only script. It marks the document as script-enabled so the
        entry animations can run; without it nothing is hidden, the page
        simply appears at once. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Julio Paniagua" />

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.code} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#050506" />

    {/* Only the grotesk is preloaded: it paints the brand, which is the
        largest contentful element. The monospace can swap in a beat later. */}
    <link
      rel="preload"
      href="/fonts/switzer-900.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CH' : 'en_GB'} />
    <meta property="og:site_name" content="Paniagua.dev" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={shareImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>

  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-void"
    >
      {skipToContent}
    </a>

    <slot />
  </body>
</html>
